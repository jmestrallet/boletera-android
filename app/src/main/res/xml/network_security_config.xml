<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
    <!-- STM omits this public intermediate in its TLS handshake (verified 2026-09-09).
         Supplement only this exact origin. All hostname/date checks still belong to Android.
         No SslErrorHandler.proceed(), custom permissive TrustManager, or user CA store. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">stm.gub.uy</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/certum_dv_tls_g2_r39" />
        </trust-anchors>
    </domain-config>
    <!-- These gateways send R46 without its legacy cross-sign. Supplement only these
         exact hosts with Sectigo's public R46 certificate signed by USERTrust RSA.
         Its chain was verified against the physical Android 11 system trust store.
         Hostname, validity and TLS checks remain enforced by Android. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">spf.sistarbanc.com.uy</domain>
        <domain includeSubdomains="false">pasarelaspe.sistarbanc.com.uy</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/sectigo_r46_usertrust" />
        </trust-anchors>
    </domain-config>
</network-security-config>
